# Local development needs no .env: docker compose up has safe defaults.
# In production, set these in the Dokploy UI. Never commit real values.

# Required.
APP_ENV=production
APP_URL=https://gmb.axxeler.in
API_URL=https://gmb.axxeler.in/api
PUBLIC_MEDIA_URL=https://gmb.axxeler.in/media
# Proxies in front of the API: Dokploy and Caddy.
TRUST_PROXY_HOPS=2

# Required. Generate each with: openssl rand -hex 32
JWT_SECRET=change-me
# Losing this makes stored Google tokens and OpenAI keys unreadable.
ENCRYPTION_KEY=change-me

# Optional. Postgres and MinIO are private to Docker and work without these.
# If you set one, keep it: each volume keeps the value it first started with.
# Use hex for the postgres password, as it needs no URL encoding.
# POSTGRES_PASSWORD=
# MINIO_SECRET_KEY=
POSTGRES_USER=localpilot
POSTGRES_DB=localpilot
MINIO_ACCESS_KEY=localpilot
MINIO_BUCKET=localpilot

# Optional. Built from the POSTGRES_ values when left out, using the postgres
# service name as the host. Characters like @ : / # in a password must be
# URL-encoded here, for example @ becomes %40.
# DATABASE_URL=postgresql://localpilot:password@postgres:5432/localpilot

# Required. Addresses allowed to register, separated by commas.
SIGNUP_ALLOWED_EMAILS=you@example.com
# Optional. Creates a verified owner on first start.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# Optional. Without all of these the app runs with email off: reset links and
# invites can't be sent, and Send test email says what's missing.
# SMTP_PASS is a Google App Password.
MAIL_PROVIDER=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=aiwithsalman33@gmail.com
SMTP_PASS=
MAIL_FROM="LocalPilot <aiwithsalman33@gmail.com>"
# Gmail allows roughly 500 a day. Account emails don't count toward this cap.
MAIL_DAILY_CAP=300

# mock keeps the app usable until Google approves Business Profile API access.
GBP_ADAPTER=mock
MOCK_SAMPLE_DATA=true

# Optional at startup. Can also be set in Settings > Google, which takes priority.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# The account holding Manager access to clients. Not a secret, and can't log in.
AGENCY_GOOGLE_EMAIL=baranikumargd2@gmail.com
# Password login stays as a backup when Google login is on.
AUTH_PASSWORD_ENABLED=true
# Per-client sign-in links. Outside users see Google's unverified-app warning.
ENABLE_CLIENT_OAUTH_LINKS=false

# openai uses the key saved in Account Settings. mock is allowed while GBP_ADAPTER=mock.
AI_ADAPTER=openai

# Optional delivery of the client guide by WhatsApp or SMS.
WHATSAPP_WEBHOOK_URL=
SMS_WEBHOOK_URL=

# Daily database dumps to keep.
BACKUP_KEEP=14
