# Local development needs no .env: docker compose up has safe defaults.
# In production, set these in the Dokploy UI. Never commit real values.

APP_ENV=production

APP_URL=https://gmb.axxeler.in
API_URL=https://gmb.axxeler.in/api
PUBLIC_MEDIA_URL=https://gmb.axxeler.in/media
# Proxies in front of the API: Dokploy and Caddy.
TRUST_PROXY_HOPS=2

POSTGRES_USER=localpilot
POSTGRES_PASSWORD=change-me
POSTGRES_DB=localpilot

# openssl rand -base64 48
JWT_SECRET=change-me
# openssl rand -base64 32. Losing this makes stored Google tokens and OpenAI keys unreadable.
ENCRYPTION_KEY=change-me

# Comma-separated addresses allowed to register.
SIGNUP_ALLOWED_EMAILS=you@example.com
# Optional. Creates a verified owner on first start.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

MAIL_PROVIDER=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=aiwithsalman33@gmail.com
# A Google App Password. Set it in Dokploy only.
SMTP_PASS=
MAIL_FROM="LocalPilot <aiwithsalman33@gmail.com>"
# Gmail allows roughly 500 a day. Account emails don't count toward this cap.
MAIL_DAILY_CAP=300

# Generate a long random password for MINIO_SECRET_KEY.
MINIO_ACCESS_KEY=localpilot
MINIO_SECRET_KEY=change-me
MINIO_BUCKET=localpilot

# mock needs no Google approval. real needs the two values below.
GBP_ADAPTER=mock
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# openai uses the key saved in Account Settings.
AI_ADAPTER=openai

# Optional delivery of the client guide by WhatsApp or SMS.
WHATSAPP_WEBHOOK_URL=
SMS_WEBHOOK_URL=

# Daily database dumps to keep.
BACKUP_KEEP=14
