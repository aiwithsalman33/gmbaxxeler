generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AuthTokenKind {
  verify_email
  reset_password
}

enum EmailStatus {
  queued
  sent
  failed
  capped
}

enum MemberRole {
  owner
  member
}

enum ConnectionStatus {
  active
  revoked
  error
  disconnected
}

enum OAuthPurpose {
  login
  agency
  invite
}

enum ConnectionSource {
  agency
  invite
}

enum ClientStatus {
  invited
  waiting_for_access
  connected
  reconnect_required
  access_removed
  paused
  removed
}

enum MatchMethod {
  auto_name
  auto_address
  auto_phone
  manual
  import
  oauth
}

enum InvitationStatus {
  pending
  needs_review
  accepted
  declined
}

enum ReminderKind {
  day_2
  day_5
}

enum FolderKind {
  photos
  seo_images
}

enum JobType {
  photo
  seo_post
}

enum JobStatus {
  scheduled
  publishing
  published
  failed
  dead
  skipped
  needs_images
  awaiting_approval
}

enum SeoMode {
  auto
  draft
}

enum ReviewReplyState {
  unreplied
  draft
  replied
}

enum ReplyStatus {
  draft
  scheduled
  publishing
  published
  failed
  cancelled
}

enum ReplySource {
  manual
  ai
}

enum ReplyMode {
  draft_only
  auto_4_5
  full_auto
}

enum NotificationSeverity {
  info
  warning
  critical
}

model User {
  id               String    @id @default(uuid()) @db.Uuid
  email            String    @unique @db.Citext
  passwordHash     String?   @map("password_hash")
  name             String?
  phone            String?
  googleSubject    String?   @unique @map("google_subject")
  emailVerifiedAt  DateTime? @map("email_verified_at")
  failedLoginCount Int       @default(0) @map("failed_login_count")
  lockedUntil      DateTime? @map("locked_until")
  lastLoginAt      DateTime? @map("last_login_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  memberships WorkspaceMember[]
  sessions    Session[]
  owned       Workspace[]
  authTokens  AuthToken[]

  @@map("users")
}

/// One row. Login happens before a workspace is known, so these are app-wide.
model AppSettings {
  id                    Int       @id @default(1)
  googleClientId        String?   @map("google_client_id")
  googleClientSecretEnc String?   @map("google_client_secret_enc")
  keyVersion            Int       @default(1) @map("key_version")
  credentialsStatus     String    @default("unknown") @map("credentials_status")
  testedAt              DateTime? @map("tested_at")
  apiAccess             String    @default("unknown") @map("api_access")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  @@map("app_settings")
}

model OAuthState {
  id              String       @id @default(uuid()) @db.Uuid
  stateHash       String       @unique @map("state_hash")
  purpose         OAuthPurpose
  workspaceId     String?      @map("workspace_id") @db.Uuid
  userId          String?      @map("user_id") @db.Uuid
  inviteId        String?      @map("invite_id") @db.Uuid
  codeVerifierEnc String       @map("code_verifier_enc")
  expiresAt       DateTime     @map("expires_at")
  usedAt          DateTime?    @map("used_at")
  createdAt       DateTime     @default(now()) @map("created_at")

  @@map("oauth_states")
}

model AuthToken {
  id        String        @id @default(uuid()) @db.Uuid
  userId    String        @map("user_id") @db.Uuid
  kind      AuthTokenKind
  tokenHash String        @unique @map("token_hash")
  expiresAt DateTime      @map("expires_at")
  usedAt    DateTime?     @map("used_at")
  createdAt DateTime      @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, kind])
  @@map("auth_tokens")
}

model TeamInvite {
  id          String     @id @default(uuid()) @db.Uuid
  workspaceId String     @map("workspace_id") @db.Uuid
  email       String     @db.Citext
  role        MemberRole @default(member)
  tokenHash   String     @unique @map("token_hash")
  invitedById String     @map("invited_by_id") @db.Uuid
  expiresAt   DateTime   @map("expires_at")
  acceptedAt  DateTime?  @map("accepted_at")
  createdAt   DateTime   @default(now()) @map("created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@map("team_invites")
}

model EmailLog {
  id            String      @id @default(uuid()) @db.Uuid
  workspaceId   String?     @map("workspace_id") @db.Uuid
  clientId      String?     @map("client_id") @db.Uuid
  to            String
  template      String
  status        EmailStatus @default(queued)
  transactional Boolean     @default(false)
  error         String?
  sentAt        DateTime?   @map("sent_at")
  createdAt     DateTime    @default(now()) @map("created_at")

  @@index([workspaceId, createdAt])
  @@map("email_log")
}

model Session {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  refreshTokenHash String    @unique @map("refresh_token_hash")
  expiresAt        DateTime  @map("expires_at")
  revokedAt        DateTime? @map("revoked_at")
  userAgent        String?   @map("user_agent")
  createdAt        DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Workspace {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  timezone  String   @default("UTC")
  ownerId   String   @map("owner_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  owner         User               @relation(fields: [ownerId], references: [id])
  members       WorkspaceMember[]
  connections   GoogleConnection[]
  clients       Client[]
  invitations   GbpInvitation[]
  invites       ClientInvite[]
  notifications Notification[]
  auditLogs     AuditLog[]
  openai        OpenaiSettings?

  notificationSettings NotificationSettings?
  teamInvites          TeamInvite[]

  @@map("workspaces")
}

model WorkspaceMember {
  id          String     @id @default(uuid()) @db.Uuid
  workspaceId String     @map("workspace_id") @db.Uuid
  userId      String     @map("user_id") @db.Uuid
  role        MemberRole @default(member)
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@map("workspace_members")
}

model GoogleConnection {
  id                   String           @id @default(uuid()) @db.Uuid
  workspaceId          String           @map("workspace_id") @db.Uuid
  googleAccountEmail   String           @map("google_account_email")
  googleSubject        String           @map("google_subject")
  refreshTokenEnc      String?          @map("refresh_token_enc")
  accessTokenEnc       String?          @map("access_token_enc")
  accessTokenExpiresAt DateTime?        @map("access_token_expires_at")
  googleName           String?          @map("google_name")
  lastError            String?          @map("last_error")
  lastSyncedAt         DateTime?        @map("last_synced_at")
  accountsCount        Int              @default(0) @map("accounts_count")
  locationsCount       Int              @default(0) @map("locations_count")
  mismatchConfirmedAt  DateTime?        @map("mismatch_confirmed_at")
  keyVersion           Int              @default(1) @map("key_version")
  scopes               String[]
  status               ConnectionStatus @default(active)
  source               ConnectionSource @default(agency)
  createdAt            DateTime         @default(now()) @map("created_at")
  updatedAt            DateTime         @updatedAt @map("updated_at")

  workspace   Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  clients     Client[]
  invitations GbpInvitation[]

  @@unique([workspaceId, googleSubject])
  @@index([workspaceId])
  @@map("google_connections")
}

model ClientInvite {
  id           String    @id @default(uuid()) @db.Uuid
  workspaceId  String    @map("workspace_id") @db.Uuid
  clientId     String?   @map("client_id") @db.Uuid
  tokenHash    String    @unique @map("token_hash")
  contactPhone String?   @map("contact_phone")
  contactEmail String?   @map("contact_email")
  expiresAt    DateTime  @map("expires_at")
  acceptedAt   DateTime? @map("accepted_at")
  connectionId String?   @map("connection_id") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@map("client_invites")
}

model Client {
  id                String       @id @default(uuid()) @db.Uuid
  workspaceId       String       @map("workspace_id") @db.Uuid
  connectionId      String?      @map("connection_id") @db.Uuid
  gbpAccountId      String?      @map("gbp_account_id")
  gbpLocationId     String?      @map("gbp_location_id")
  name              String
  timezone          String       @default("UTC")
  status            ClientStatus @default(invited)
  contactPhone      String?      @map("contact_phone")
  contactEmail      String?      @map("contact_email")
  address           String?
  notes             String?
  aiRenameEnabled   Boolean      @default(true) @map("ai_rename_enabled")
  matchMethod       MatchMethod? @map("match_method")
  invitedAt         DateTime?    @map("invited_at")
  guideSentAt       DateTime?    @map("guide_sent_at")
  inviteEmailSentAt DateTime?    @map("invite_email_sent_at")
  connectedAt       DateTime?    @map("connected_at")
  accessLostAt      DateTime?    @map("access_lost_at")
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")

  workspace     Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  connection    GoogleConnection? @relation(fields: [connectionId], references: [id], onDelete: SetNull)
  profile       ClientProfile?
  stats         LocationStats?
  folders       LibraryFolder[]
  images        LibraryImage[]
  metrics       MetricSnapshot[]
  reminders     ClientReminder[]
  invitations   GbpInvitation[]
  photoSchedule PhotoSchedule?
  jobs          ScheduledJob[]
  publishLogs   PublishLog[]
  aiUsage       AiUsage[]

  seoSchedule    SeoSchedule?
  posts          Post[]
  reviews        Review[]
  reviewReplies  ReviewReply[]
  reviewSettings ReviewSettings?

  @@unique([workspaceId, id])
  @@unique([workspaceId, gbpLocationId])
  @@index([workspaceId, status])
  @@map("clients")
}

model ClientProfile {
  clientId       String    @id @map("client_id") @db.Uuid
  gbpSnapshot    Json      @default("{}") @map("gbp_snapshot")
  description    String?
  services       String[]
  targetAreas    String[]  @map("target_areas")
  usps           String[]
  tone           String?
  strategy       String?
  competitors    String[]
  keywords       String[]
  dos            String[]
  donts          String[]
  ctaUrl         String?   @map("cta_url")
  ctaType        String    @default("LEARN_MORE") @map("cta_type")
  seoMode        SeoMode   @default(draft) @map("seo_mode")
  draftLeadHours Int       @default(48) @map("draft_lead_hours")
  onboardedAt    DateTime? @map("onboarded_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@map("client_profiles")
}

model GbpInvitation {
  id                String           @id @default(uuid()) @db.Uuid
  workspaceId       String           @map("workspace_id") @db.Uuid
  connectionId      String           @map("connection_id") @db.Uuid
  invitationName    String           @map("invitation_name")
  accountId         String           @map("account_id")
  targetType        String           @map("target_type")
  role              String
  locationName      String?          @map("location_name")
  address           String?
  placeId           String?          @map("place_id")
  status            InvitationStatus @default(pending)
  matchedClientId   String?          @map("matched_client_id") @db.Uuid
  matchScore        Float?           @map("match_score")
  matchReason       String?          @map("match_reason")
  suggestedClientId String?          @map("suggested_client_id") @db.Uuid
  firstSeenAt       DateTime         @default(now()) @map("first_seen_at")
  resolvedAt        DateTime?        @map("resolved_at")
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")

  workspace  Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  connection GoogleConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  client     Client?          @relation(fields: [matchedClientId], references: [id], onDelete: SetNull)

  @@unique([workspaceId, invitationName])
  @@index([workspaceId, status])
  @@map("gbp_invitations")
}

model ClientReminder {
  id          String       @id @default(uuid()) @db.Uuid
  workspaceId String       @map("workspace_id") @db.Uuid
  clientId    String       @map("client_id") @db.Uuid
  kind        ReminderKind
  channel     String
  sentAt      DateTime     @default(now()) @map("sent_at")

  client Client @relation(fields: [workspaceId, clientId], references: [workspaceId, id], onDelete: Cascade)

  @@unique([clientId, kind])
  @@map("client_reminders")
}

model LibraryFolder {
  id          String     @id @default(uuid()) @db.Uuid
  workspaceId String     @map("workspace_id") @db.Uuid
  clientId    String     @map("client_id") @db.Uuid
  kind        FolderKind
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  client Client         @relation(fields: [workspaceId, clientId], references: [workspaceId, id], onDelete: Cascade)
  images LibraryImage[]

  @@unique([clientId, kind])
  @@index([workspaceId, clientId])
  @@map("library_folders")
}

model LibraryImage {
  id           String    @id @default(uuid()) @db.Uuid
  workspaceId  String    @map("workspace_id") @db.Uuid
  clientId     String    @map("client_id") @db.Uuid
  folderId     String    @map("folder_id") @db.Uuid
  storageKey   String    @map("storage_key")
  publicUrl    String    @map("public_url")
  originalName String    @map("original_name")
  seoName      String?   @map("seo_name")
  mime         String
  bytes        Int
  width        Int
  height       Int
  sha256       String
  tags         String[]
  usageCount   Int       @default(0) @map("usage_count")
  lastUsedAt   DateTime? @map("last_used_at")
  deletedAt    DateTime? @map("deleted_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  client Client         @relation(fields: [workspaceId, clientId], references: [workspaceId, id], onDelete: Cascade)
  folder LibraryFolder  @relation(fields: [folderId], references: [id], onDelete: Cascade)
  jobs   ScheduledJob[]

  @@index([clientId, folderId, lastUsedAt])
  @@map("library_images")
}

model MetricSnapshot {
  id          String   @id @default(uuid()) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  clientId    String   @map("client_id") @db.Uuid
  date        DateTime @db.Date
  metric      String
  value       Int
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  client Client @relation(fields: [workspaceId, clientId], references: [workspaceId, id], onDelete: Cascade)

  @@unique([clientId, date, metric])
  @@index([workspaceId, clientId, date])
  @@map("metric_snapshots")
}

model LocationStats {
  clientId      String    @id @map("client_id") @db.Uuid
  rating        Float?
  reviewCount   Int       @default(0) @map("review_count")
  photoCount    Int       @default(0) @map("photo_count")
  lastPostAt    DateTime? @map("last_post_at")
  strengthScore Int       @default(0) @map("strength_score")
  checklist     Json      @default("[]")
  syncedAt      DateTime? @map("synced_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@map("location_stats")
}

model Notification {
  id          String               @id @default(uuid()) @db.Uuid
  workspaceId String               @map("workspace_id") @db.Uuid
  clientId    String?              @map("client_id") @db.Uuid
  userId      String?              @map("user_id") @db.Uuid
  type        String
  severity    NotificationSeverity @default(info)
  title       String
  body        String
  readAt      DateTime?            @map("read_at")
  createdAt   DateTime             @default(now()) @map("created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, readAt, createdAt])
  @@map("notifications")
}

model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  clientId    String?  @map("client_id") @db.Uuid
  actorId     String?  @map("actor_id") @db.Uuid
  action      String
  entity      String
  entityId    String?  @map("entity_id")
  meta        Json     @default("{}")
  createdAt   DateTime @default(now()) @map("created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
  @@map("audit_logs")
}

model PhotoSchedule {
  id              String   @id @default(uuid()) @db.Uuid
  workspaceId     String   @map("workspace_id") @db.Uuid
  clientId        String   @unique @map("client_id") @db.Uuid
  weekdays        Int[]
  localTime       String   @map("local_time")
  timezone        String
  countPerDay     Int      @map("count_per_day")
  defaultCategory String   @default("ADDITIONAL") @map("default_category")
  enabled         Boolean  @default(true)
  version         Int      @default(1)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  client Client @relation(fields: [workspaceId, clientId], references: [workspaceId, id], onDelete: Cascade)

  @@unique([workspaceId, clientId])
  @@map("photo_schedules")
}

model ScheduledJob {
  id              String    @id @default(uuid()) @db.Uuid
  workspaceId     String    @map("workspace_id") @db.Uuid
  clientId        String    @map("client_id") @db.Uuid
  type            JobType
  scheduleId      String?   @map("schedule_id") @db.Uuid
  scheduleVersion Int       @default(1) @map("schedule_version")
  runAt           DateTime  @map("run_at")
  status          JobStatus @default(scheduled)
  attempts        Int       @default(0)
  error           String?
  category        String?
  imageId         String?   @map("image_id") @db.Uuid
  payload         Json      @default("{}")
  manuallyEdited  Boolean   @default(false) @map("manually_edited")
  idempotencyKey  String    @unique @map("idempotency_key")
  startedAt       DateTime? @map("started_at")
  finishedAt      DateTime? @map("finished_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  client Client        @relation(fields: [workspaceId, clientId], references: [workspaceId, id], onDelete: Cascade)
  image  LibraryImage? @relation(fields: [imageId], references: [id], onDelete: SetNull)
  logs   PublishLog[]

  post Post?

  @@index([clientId, runAt])
  @@index([status, runAt])
  @@map("scheduled_jobs")
}

model PublishLog {
  id              String   @id @default(uuid()) @db.Uuid
  workspaceId     String   @map("workspace_id") @db.Uuid
  clientId        String   @map("client_id") @db.Uuid
  jobId           String   @map("job_id") @db.Uuid
  action          String
  status          String
  originalName    String?  @map("original_name")
  newName         String?  @map("new_name")
  gbpResourceName String?  @map("gbp_resource_name")
  error           String?
  meta            Json     @default("{}")
  createdAt       DateTime @default(now()) @map("created_at")

  client Client       @relation(fields: [workspaceId, clientId], references: [workspaceId, id], onDelete: Cascade)
  job    ScheduledJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([clientId, createdAt])
  @@index([jobId])
  @@map("publish_logs")
}

model OpenaiSettings {
  workspaceId     String   @id @map("workspace_id") @db.Uuid
  apiKeyEnc       String   @map("api_key_enc")
  keyVersion      Int      @default(1) @map("key_version")
  keyLast4        String   @map("key_last4")
  visionModel     String   @map("vision_model")
  inputPricePerM  Float    @map("input_price_per_m")
  outputPricePerM Float    @map("output_price_per_m")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map("openai_settings")
}

model AiUsage {
  id           String   @id @default(uuid()) @db.Uuid
  workspaceId  String   @map("workspace_id") @db.Uuid
  clientId     String   @map("client_id") @db.Uuid
  feature      String
  model        String
  inputTokens  Int      @map("input_tokens")
  outputTokens Int      @map("output_tokens")
  estCost      Float    @map("est_cost")
  createdAt    DateTime @default(now()) @map("created_at")

  client Client @relation(fields: [workspaceId, clientId], references: [workspaceId, id], onDelete: Cascade)

  @@index([workspaceId, clientId, createdAt])
  @@map("ai_usage")
}

model SeoSchedule {
  id              String   @id @default(uuid()) @db.Uuid
  workspaceId     String   @map("workspace_id") @db.Uuid
  clientId        String   @unique @map("client_id") @db.Uuid
  weekdays        Int[]
  localTime       String   @map("local_time")
  timezone        String
  countPerDay     Int      @map("count_per_day")
  defaultPostType String   @default("standard") @map("default_post_type")
  enabled         Boolean  @default(true)
  version         Int      @default(1)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  client Client @relation(fields: [workspaceId, clientId], references: [workspaceId, id], onDelete: Cascade)

  @@unique([workspaceId, clientId])
  @@map("seo_schedules")
}

/// postType and eventOffer leave room for event and offer posts later.
model Post {
  id           String    @id @default(uuid()) @db.Uuid
  workspaceId  String    @map("workspace_id") @db.Uuid
  clientId     String    @map("client_id") @db.Uuid
  jobId        String    @unique @map("job_id") @db.Uuid
  postType     String    @default("standard") @map("post_type")
  summary      String
  ctaType      String    @default("LEARN_MORE") @map("cta_type")
  ctaUrl       String?   @map("cta_url")
  eventOffer   Json?     @map("event_offer")
  aiGenerated  Boolean   @default(true) @map("ai_generated")
  approvedById String?   @map("approved_by_id") @db.Uuid
  approvedAt   DateTime? @map("approved_at")
  gbpPostName  String?   @map("gbp_post_name")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  client Client       @relation(fields: [workspaceId, clientId], references: [workspaceId, id], onDelete: Cascade)
  job    ScheduledJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([clientId, createdAt])
  @@map("posts")
}

model Review {
  id           String           @id @default(uuid()) @db.Uuid
  workspaceId  String           @map("workspace_id") @db.Uuid
  clientId     String           @map("client_id") @db.Uuid
  gbpReviewId  String           @map("gbp_review_id")
  rating       Int
  text         String?
  reviewerName String           @map("reviewer_name")
  reviewedAt   DateTime         @map("reviewed_at")
  replyState   ReviewReplyState @default(unreplied) @map("reply_state")
  replyText    String?          @map("reply_text")
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")

  client  Client        @relation(fields: [workspaceId, clientId], references: [workspaceId, id], onDelete: Cascade)
  replies ReviewReply[]

  @@unique([clientId, gbpReviewId])
  @@index([clientId, reviewedAt])
  @@map("reviews")
}

model ReviewReply {
  id           String      @id @default(uuid()) @db.Uuid
  workspaceId  String      @map("workspace_id") @db.Uuid
  clientId     String      @map("client_id") @db.Uuid
  reviewId     String      @map("review_id") @db.Uuid
  text         String
  status       ReplyStatus @default(draft)
  source       ReplySource @default(ai)
  publishAt    DateTime?   @map("publish_at")
  attempts     Int         @default(0)
  error        String?
  approvedById String?     @map("approved_by_id") @db.Uuid
  publishedAt  DateTime?   @map("published_at")
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")

  client Client @relation(fields: [workspaceId, clientId], references: [workspaceId, id], onDelete: Cascade)
  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@index([status, publishAt])
  @@index([reviewId])
  @@map("review_replies")
}

model ReviewSettings {
  clientId         String    @id @map("client_id") @db.Uuid
  autoReplyEnabled Boolean   @default(false) @map("auto_reply_enabled")
  replyBrain       String?   @map("reply_brain")
  mode             ReplyMode @default(draft_only)
  delayMinS        Int       @default(300) @map("delay_min_s")
  delayMaxS        Int       @default(3600) @map("delay_max_s")
  lastSyncedAt     DateTime? @map("last_synced_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@map("review_settings")
}

model NotificationSettings {
  workspaceId   String   @id @map("workspace_id") @db.Uuid
  emails        String[]
  webhookUrl    String?  @map("webhook_url")
  webhookKind   String   @default("generic") @map("webhook_kind")
  webhookChatId String?  @map("webhook_chat_id")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map("notification_settings")
}

/// Persists fake Google state so the API and worker share it. Mock adapter only.
model MockGbpState {
  workspaceId String   @id @map("workspace_id") @db.Uuid
  state       Json     @default("{}")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("mock_gbp_state")
}
